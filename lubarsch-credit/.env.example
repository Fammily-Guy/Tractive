# ─── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.lubarschcredit.com

# ─── Security (REQUIRED in production) ─────────────────────────────────
# 32 random bytes, base64. Encrypts BVN and ID numbers at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# 32+ random characters. Signs staff login sessions.
SESSION_SECRET=

# ─── Staff accounts (/admin) ───────────────────────────────────────────
# JSON array. Create hashes + 2FA secrets with: npm run hash-password -- "a-long-password"
# Roles: admin | officer | viewer. 2FA (totpSecret) is mandatory in production.
ADMIN_USERS=[{"email":"you@lubarschcredit.com","name":"Your Name","role":"admin","passwordHash":"scrypt$...","totpSecret":"BASE32SECRET"}]

# ─── Database (Supabase) — leave empty to use the local .data/ JSON file ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=application-documents

# ─── SMS / WhatsApp: termii | twilio | console (console = just log) ────
MESSAGING_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=Lubarsch
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# ─── Email to staff: resend | console ──────────────────────────────────
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Lubarsch Credit <no-reply@lubarschcredit.com>"
STAFF_NOTIFY_EMAIL=staff@lubarschcredit.com

# ─── Check-status one-time code by SMS ─────────────────────────────────
STATUS_OTP_REQUIRED=false

# ─── Identity verification (interface only — not called yet) ───────────
IDENTITY_PROVIDER=
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
PREMBLY_API_KEY=
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=

# ─── Payments, phase 2 (interface only) ────────────────────────────────
PAYMENTS_PROVIDER=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# ─── Spam protection on forms (optional, Cloudflare Turnstile) ─────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Analytics (optional; loads only after visitor accepts) ────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
